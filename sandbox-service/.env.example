# sandbox-service 本地启动默认配置。
# 如需调整，复制为 sandbox-service/.env；start/stop 脚本会自动读取。

# Java 后端和 sandbox-service 之间的内部鉴权 token，需与后端 AGENT_HUB_SANDBOX_INTERNAL_TOKEN 保持一致。
SANDBOX_INTERNAL_TOKEN=dev-sandbox-token

# sandbox-service 监听地址；0.0.0.0:8090 允许宿主机和局域网内后端访问。
SANDBOX_LISTEN_ADDR=0.0.0.0:8090

# VM 运行模式；firecracker 表示使用 Firecracker microVM，dev-agent 仅用于接口联调。
SANDBOX_VM_MODE=firecracker

# Firecracker 可执行文件路径。
SANDBOX_FIRECRACKER_BIN=/usr/local/bin/firecracker

# Firecracker 运行目录，用于保存 socket、日志和每个 VM 的 rootfs 副本。
SANDBOX_FIRECRACKER_RUN_DIR=${SERVICE_DIR}/run

# Firecracker kernel 镜像路径。
SANDBOX_KERNEL_IMAGE=${SERVICE_DIR}/rootfs/vmlinux

# Firecracker rootfs ext4 镜像路径。
SANDBOX_ROOTFS_IMAGE=${SERVICE_DIR}/rootfs/rootfs.ext4

# 预热 VM 数量；本地开发建议保持 1，减少首次会话等待。
SANDBOX_WARM_POOL_SIZE=1

# 最大活跃沙箱会话数量，防止本机资源被耗尽。
SANDBOX_MAX_ACTIVE_SESSIONS=5

# 会话空闲回收时间，超过该时间未活跃的沙箱会被释放。
SANDBOX_IDLE_TIMEOUT=5m

# 单个 microVM 的 vCPU 数量。
SANDBOX_VM_CPU=1

# 单个 microVM 的内存大小，单位 MB。
SANDBOX_VM_MEMORY_MB=1024

# 单个 microVM 的磁盘大小，单位 GB；需要能容纳 rootfs 副本和运行产物。
SANDBOX_VM_DISK_GB=8

# microVM 内 sandbox-agent 监听端口。
SANDBOX_GUEST_AGENT_PORT=8081

# 分配给 microVM 的宿主侧网络地址池。
SANDBOX_GUEST_NETWORK_CIDR=172.16.200.0/24

# 宿主机 tap 设备名前缀。
SANDBOX_TAP_NAME_PREFIX=tap-ah

# 允许沙箱访问的目标网段，多个 CIDR 用英文逗号分隔。
SANDBOX_NETWORK_ALLOW_CIDRS=127.0.0.1/32

# 沙箱产物对象存储地址；本地默认指向 docker MinIO。
SANDBOX_OBJECT_ENDPOINT=127.0.0.1:9000

# 对象存储访问账号，需与 docker/env/minio.env 保持一致。
SANDBOX_OBJECT_ACCESS_KEY=agenthub

# 对象存储访问密码，需与 docker/env/minio.env 保持一致。
SANDBOX_OBJECT_SECRET_KEY=agenthub123

# 沙箱产物使用的对象存储 bucket。
SANDBOX_OBJECT_BUCKET=agent-hub-sandbox-artifacts

# 对象存储是否使用 HTTPS；本地 MinIO 默认 false。
SANDBOX_OBJECT_SECURE=false
