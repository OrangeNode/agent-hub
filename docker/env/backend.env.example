SERVER_PORT=8080
TZ=Asia/Shanghai
JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Shanghai
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/agent_hub?options=-c%20TimeZone%3DAsia%2FShanghai
SPRING_DATASOURCE_USERNAME=agent_hub
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=CHANGE_ME
# 至少 32 字节的随机字符串，可用 `openssl rand -base64 48` 生成；未配置时后端拒绝启动。
AGENT_HUB_JWT_SECRET=CHANGE_ME
AGENT_HUB_JWT_TTL_HOURS=12
AGENT_HUB_PUBLIC_HOST=${AGENT_HUB_PUBLIC_HOST:-172.16.112.183}
AGENT_HUB_STORAGE_ENDPOINT=${AGENT_HUB_STORAGE_ENDPOINT:-http://127.0.0.1:9000}
AGENT_HUB_STORAGE_PUBLIC_ENDPOINT=${AGENT_HUB_STORAGE_PUBLIC_ENDPOINT:-http://${AGENT_HUB_PUBLIC_HOST}:9000}
AGENT_HUB_STORAGE_ACCESS_KEY=${AGENT_HUB_STORAGE_ACCESS_KEY:-CHANGE_ME}
AGENT_HUB_STORAGE_SECRET_KEY=${AGENT_HUB_STORAGE_SECRET_KEY:-CHANGE_ME}
AGENT_HUB_STORAGE_BUCKET=${AGENT_HUB_STORAGE_BUCKET:-agent-hub-chat-images}
AGENT_HUB_STORAGE_SKILL_BUCKET=${AGENT_HUB_STORAGE_SKILL_BUCKET:-agent-hub-skill-packages}
# 需与 sandbox-service 的 SANDBOX_INTERNAL_TOKEN 保持一致。
AGENT_HUB_SANDBOX_INTERNAL_TOKEN=CHANGE_ME
